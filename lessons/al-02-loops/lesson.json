    {
      "id": "count",
      "seconds": 18,
      "heading": "Counting with a mask",
      "narration": "Masks and reduce work well together. A comparison gives ones and zeros. Adding them up counts the matches. So two values are greater than five. Reduce, given and, asks whether every value passes. Every value is greater than one, so it gives one.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "xtl": "values > 5"
          },
          {
            "code": "0 0 1 1"
          },
          {
            "xtl": "'+ r_/ values > 5"
          },
          {
            "code": "2"
          },
          {
            "xtl": "'& r_/ values > 1"
          },
          {
            "code": "1"
          }
        ],
        "focus": [
