    {
      "id": "reduce",
      "seconds": 16,
      "heading": "Reduce",
      "narration": "The third job is a reduce. A reduce combines many elements into one. Reduce, given plus, adds them up, and gives twenty. Given max, it gives the largest value, eight. Given min, it gives the smallest, two.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "xtl": "'+ r_/ values"
          },
          {
            "code": "20"
          },
          {
            "xtl": "'m_ax r_/ values"
          },
          {
            "code": "8"
          },
          {
            "xtl": "'m_in r_/ values"
          },
          {
            "code": "2"
          }
