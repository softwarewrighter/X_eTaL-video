            "sub": "+"
          }
        ]
      }
    },
    {
      "id": "map",
      "seconds": 12,
      "heading": "Map",
      "narration": "The first job is a map. Three times values gives six, twelve, eighteen, twenty four. Every input element produces one output element. The shape stays the same.",
      "lines": [],
      "panel": {
        "type": "cells",
        "mode": "whole",
        "from": "2 4 6 8",
        "to": "3 * 2 4 6 8",
        "op": "× 3, the whole array at once"
      }
    },
    {
      "id": "map-code",
      "seconds": 10,
      "heading": "Tripled",
      "narration": "{X_eTaL|@xtl} says it in one line. Tripled is three times values. There is no loop, and no index.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "xtl": "values := 2 4 6 8"
          },
          {
            "xtl": "tripled := 3 * values"
          },
          {
            "xtl": "tripled"
          },
          {
            "code": "6 12 18 24"
          }
        ],
        "focus": [
          [
            1
          ],
          [
            1,
            2,
            3
          ],
          []
        ]
      }
    },
    {
      "id": "filter-mask",
      "seconds": 14,
      "heading": "Filter: a question for every element",
      "narration": "The second job is a filter. First, we ask every element the same question. We ask if it is greater than five. The answer is zero, zero, one, one. That is a mask. One means keep, and zero means drop.",
      "lines": [],
      "panel": {
        "type": "cells",
        "mode": "whole",
        "from": "2 4 6 8",
        "to": "2 4 6 8 > 5",
        "op": "> 5, a mask"
      }
    },
    {
      "id": "filter-code",
      "seconds": 15,
      "heading": "Replicate",
      "narration": "Replicate uses the mask to choose. Each value is kept as many times as its mask says. So the result is six, eight. The output is shorter than the input. That is what makes a filter different from a map.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "xtl": "values > 5"
          },
          {
            "code": "0 0 1 1"
          },
          {
            "xtl": "(values > 5) r_eplicate values"
          },
          {
            "code": "6 8"
          }
        ],
        "focus": [
          [
            0,
            1,
            2
          ],
          [
            2
          ],
          [
            2,
            3
          ],
          [
            3
          ],
          []
        ]
      }
    },
    {
      "id": "break-2",
      "seconds": 7,
      "heading": "What comes out",
      "lines": [],
      "slide": {
        "type": "points",
        "items": [
