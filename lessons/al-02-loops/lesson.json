          ]
        ]
      }
    },
    {
      "id": "how-what",
      "seconds": 10,
      "heading": "How, or what",
      "narration": "A scalar solution describes how to visit every element. An array solution describes what happens to the whole collection.",
      "lines": [],
      "slide": {
        "type": "points",
        "steps": [
          1,
          2
        ],
        "items": [
          {
            "text": "Scalar: how",
            "sub": "visit every element, one at a time"
          },
          {
            "text": "Array: what",
            "sub": "what happens to the whole collection"
          }
        ]
      }
    },
    {
      "id": "break-1",
      "seconds": 7,
      "heading": "Three operations",
      "lines": [],
      "slide": {
        "type": "flow",
        "items": [
          {
            "text": "Map",
            "sub": "× 3"
          },
          {
            "text": "Filter",
