  "scenes": [
    {
      "id": "title",
      "seconds": 8,
      "heading": "Shape, rank, axes and dimensions",
      "lines": [
        "Scalars, vectors, matrices and beyond"
      ]
    },
    {
      "id": "recap",
      "seconds": 10,
      "heading": "Last time",
      "narration": "Last time, map, filter and reduce worked on whole lists. A list is one kind of array. Today we meet the others. Every array has a shape, a rank, and {axes|@axes}.",
      "lines": [],
      "slide": {
        "type": "flow",
        "steps": [
          0,
          0,
          0,
          2
        ],
        "items": [
          {
            "text": "Shape",
            "sub": "how long each axis is"
          },
          {
            "text": "Rank",
            "sub": "how many axes"
          },
          {
            "text": "Axes",
            "sub": "the directions"
          }
        ]
      }
    },
    {
      "id": "scalar",
      "seconds": 10,
      "heading": "A scalar",
      "narration": "A scalar is a single value. It has no {axes|@axes}. Its shape is an empty list, so its rank is zero.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "xtl": "s_hape 7"
          },
          {
            "code": ""
          },
          {
            "xtl": "t_ally s_hape 7"
          },
          {
            "code": "0"
          }
        ],
        "focus": [
          [
            0
          ],
          [
            0,
            1
          ],
          [
            2,
            3
          ]
        ]
      }
    },
    {
      "id": "vector",
      "seconds": 10,
      "heading": "A vector",
      "narration": "A vector has one axis. This one holds five values, so its shape is five. Its rank is one. Rank is the length of the shape.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "xtl": "v := 3 1 4 1 5"
          },
          {
            "xtl": "s_hape v"
          },
          {
            "code": "5"
          },
          {
            "xtl": "t_ally s_hape v"
          },
          {
            "code": "1"
          }
        ],
        "focus": [
          [
            0
          ],
          [
            1,
            2
          ],
          [
            3,
            4
          ],
          [
            3
          ]
        ]
      }
    },
    {
      "id": "matrix",
      "seconds": 12,
      "heading": "A matrix",
      "narration": "A matrix has two {axes|@axes}, rows and columns. This one has two rows and three columns. Its shape is two by three. It holds six values, but its rank is two.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "xtl": "M := 2 3 r_eshape r_ange 6"
          },
          {
            "xtl": "M"
          },
          {
            "code": "1 2 3"
          },
          {
            "code": "4 5 6"
          },
          {
            "xtl": "s_hape M"
          },
          {
            "code": "2 3"
          },
          {
            "xtl": "t_ally s_hape M"
          },
          {
            "code": "2"
          }
        ],
        "focus": [
          [
            0
          ],
          [
            1,
            2,
            3
          ],
          [
            4,
