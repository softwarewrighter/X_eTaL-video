    {
      "id": "rank-3-axes",
      "seconds": 18,
      "heading": "Rank three, along an axis",
      "narration": "The same subscripts work in three dimensions. Reduce along axis one adds the two tables together. The result is three by four. Reduce along axis three sums each row. The result is two by three.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "xtl": "T := 2 3 4 r_eshape r_ange 24"
          },
          {
            "xtl": "'+ r_/_1 T"
          },
          {
            "code": "14 16 18 20"
          },
          {
            "code": "22 24 26 28"
          },
          {
            "code": "30 32 34 36"
          },
          {
            "xtl": "'+ r_/_3 T"
          },
          {
            "code": "10 26 42"
          },
          {
            "code": "58 74 90"
          }
        ],
        "focus": [
          [
