    {
      "id": "ravel",
      "seconds": 16,
      "heading": "Back to rank one",
      "narration": "Ravel turns any array into a vector. The rank three array becomes a list of twenty four values. Its rank is now one. With subscript two, a matrix unrolls column by column instead.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "xtl": "r_avel T"
          },
          {
            "code": "1 2 3 ... 22 23 24"
          },
          {
            "xtl": "s_hape r_avel T"
          },
          {
            "code": "24"
          },
          {
            "xtl": "r_avel_2 M"
          },
          {
            "code": "1 4 2 5 3 6"
          }
