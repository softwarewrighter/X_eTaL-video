    {
      "id": "tensors",
      "seconds": 20,
      "heading": "Tensors",
      "narration": "In machine learning, arrays like these are called tensors. A color image might have shape four eighty by six forty by three. That is height, width, and three color channels. Stack thirty two images and you add an axis. The batch has rank four.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "xtl": "images := 32 480 640 3 r_eshape 0"
          },
          {
            "xtl": "s_hape images"
          },
          {
            "code": "32 480 640 3"
          },
          {
            "xtl": "t_ally s_hape images"
          },
          {
            "code": "4"
          },
          {
            "xtl": "'* r_/ s_hape images"
          },
