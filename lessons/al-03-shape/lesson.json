    {
      "id": "preview-extension",
      "seconds": 22,
      "heading": "One value, or the same shape",
      "narration": "The simplest case is a single value. Ten times a matrix multiplies every item by ten. The single value extends to every item. Two arrays of the same shape combine item by item. In {X_eTaL|@xtl}, that is the whole rule. Other shapes are an error.",
      "lines": [],
      "slide": {
        "type": "points",
        "steps": [
          0,
          0,
          0,
          1,
          2,
          2
        ],
        "items": [
          {
            "text": "One value",
            "xtl": "10 * M"
          },
          {
            "text": "The same shape",
            "xtl": "M + M"
          },
          {
            "text": "Other shapes",
            "sub": "an error in X_eTaL"
          }
        ]
      }
    },
    {
      "id": "preview-dialects",
      "seconds": 30,
      "heading": "Where languages differ",
      "narration": "Array languages draw this line in different places. {APL|@apl} extends a single value too. An axis can say how a vector meets a matrix. {J|jay} and {BQN|bee, queue, en}, match {axes|@axes} from the front. Each item of a vector goes with one row. {K|kay} works much the same way. There, a matrix is a list of rows. NumPy, for Python, matches {axes|@axes} from the back. The next episode puts them side by side.",
      "lines": [],
      "slide": {
        "type": "points",
        "steps": [
          0,
          0,
          0,
          1,
          1,
          2,
          2,
          3,
          3
        ],
        "items": [
          {
            "text": "X_eTaL",
            "sub": "one value, or the same shape"
          },
          {
            "text": "APL",
            "sub": "one value; an axis says how"
          },
          {
            "text": "J, BQN, K",
            "sub": "match axes from the front"
          },
          {
            "text": "NumPy",
            "sub": "match axes from the back"
          }
        ]
      }
