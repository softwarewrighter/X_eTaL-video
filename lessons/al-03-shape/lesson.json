    {
      "id": "rank-3-transpose",
      "seconds": 18,
      "heading": "Rank three, transposed",
      "narration": "Transpose reverses all three {axes|@axes}. Two by three by four becomes four by three by two. With two subscripts, it swaps just those two {axes|@axes}. A list on the left can put the {axes|@axes} in any order.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "xtl": "s_hape o_\\ T"
          },
          {
            "code": "4 3 2"
          },
          {
            "xtl": "s_hape o_\\_23 T"
          },
          {
            "code": "2 4 3"
          },
          {
            "xtl": "s_hape 3 1 2 t_ranspose T"
          },
          {
            "code": "3 4 2"
          }
        ],
        "focus": [
