          ],
          [
            6,
            7
          ]
        ]
      }
    },
    {
      "id": "rank-3",
      "seconds": 14,
      "heading": "Rank three",
      "narration": "Add one more axis. Two tables, each three by four, make an array of shape two by three by four. Its rank is three. Higher ranks follow the same rule.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "xtl": "2 3 4 r_eshape r_ange 24"
          },
          {
            "code": " 1  2  3  4"
          },
          {
            "code": " 5  6  7  8"
          },
          {
            "code": " 9 10 11 12"
          },
          {
