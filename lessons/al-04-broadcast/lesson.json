    {
      "id": "languages",
      "seconds": 34,
      "heading": "Other array languages",
      "narration": "Other array languages draw this line in different places. M has two rows and three columns. Three values match its last axis. Two values match its first. {X_eTaL|@xtl} needs the same shape, so both are errors. {APL|@apl} does the same. {J|jay} and {BQN|bee, queue, en}{,|/} match {axes|@axes} from the front. So two values meet the two rows. The language {K|kay} works the same way. {NumPy|@numpy} matches {axes|@axes} from the back. So three values meet each row. Every one of them extends a single value.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "label": "",
            "code": "matches          M + 10 20 30  M + 100 200"
          },
