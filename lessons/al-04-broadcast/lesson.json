    {
      "id": "numpy-stretch",
      "seconds": 16,
      "heading": "NumPy: a length one axis stretches",
      "narration": "That stretching has a cost. A column of three plus a row of three gives a three by three table. If you meant item by item, there is no error. You get an answer of the wrong shape.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
