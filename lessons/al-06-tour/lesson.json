    {
      "id": "train",
      "seconds": 22,
      "heading": "A mean, as a train",
      "narration": "A train joins functions without naming the argument. Sum, divided by count, is the mean. {APL|@apl}, {J|Jay} and {BQN|@bqn} write it as a train. {X_eTaL|@xtl} writes the same fork in square brackets. {K|Kay} writes a small function instead, with a named argument.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "code": "(+/÷≢)3 1 4 1 5 9",
            "label": "APL"
          },
          {
            "code": "(+/ % #) 3 1 4 1 5 9",
            "label": "J"
          },
          {
            "code": "(+´÷≠)3‿1‿4‿1‿5‿9",
            "label": "BQN"
          },
          {
            "xtl": "['+ r_/ / t_ally] x",
            "label": "X_eTaL"
          },
          {
            "box": "3.8333333333333335",
            "label": ""
          },
          {
            "code": "{(+/x)%#x}3 1 4 1 5 9",
            "label": "K"
          }
        ],
