    {
      "id": "recap",
      "seconds": 12,
      "heading": "Last time",
      "narration": "Last time, we met eight array idioms. Today, we meet the family of languages behind them. Five languages, side by side.",
      "lines": [],
      "slide": {
        "type": "points",
        "steps": [
          0,
