    {
      "id": "tacit",
      "seconds": 20.7,
      "heading": "Explicit or tacit: both in X_eTaL",
      "narration": "One function, written two ways. The spread of a list is its largest value, minus its smallest. Written explicitly, it names its argument. Written as a train, it never does. Like {J|Jay}, {X_eTaL|@xtl} supports both styles. Both get the same type, and both give eight.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "code": "3 : '(>./y) - <./y'",
            "label": "J"
          },
          {
            "code": "(>./ - <./)",
            "label": "J"
          },
          {
            "xtl": "u:s_pread := { ('m_ax r_/ _r) - 'm_in r_/ _r }",
            "label": "explicit"
          },
          {
            "xtl": "u:s_pread := ['m_ax r_/ - 'm_in r_/]",
            "label": "tacit"
          },
