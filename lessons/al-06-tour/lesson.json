    {
      "id": "order",
      "seconds": 18,
      "heading": "Right to left",
      "narration": "All five work from right to left. There is no precedence. So three plus four comes first. Then two times seven gives fourteen. In {J|Jay} and {K|Kay}, times is typed as a star.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
          {
            "code": "2×3+4",
            "label": "APL"
          },
          {
            "code": "2*3+4",
            "label": "J"
          },
          {
            "code": "2*3+4",
            "label": "K"
          },
          {
            "code": "2×3+4",
            "label": "BQN"
          },
          {
            "xtl": "2 * 3 + 4",
            "label": "X_eTaL"
          },
