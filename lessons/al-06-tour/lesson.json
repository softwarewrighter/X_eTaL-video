    {
      "id": "reverse",
      "seconds": 18,
      "heading": "Notation: reverse",
      "narration": "Reverse shows the notation. {APL|@apl} and {BQN|@bqn} use a glyph, a circle with a bar. {J|Jay} and {K|Kay} use {ASCII|ass key} symbols. {X_eTaL|@xtl} uses a word, with its first letter underlined.",
      "lines": [],
