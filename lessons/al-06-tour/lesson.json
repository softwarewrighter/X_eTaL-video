    {
      "id": "overload",
      "seconds": 23.5,
      "heading": "One symbol, two meanings",
      "narration": "In {APL|@apl}, {J|Jay} and {K|Kay}, the same mark often does two jobs. With one argument, it gives a shape in {APL|@apl}. With two, it changes the shape. {K|Kay} counts with one mark, or takes with it. {BQN|@bqn} gives shape and reshape their own glyphs. {X_eTaL|@xtl} gives them two names.",
      "lines": [],
      "panel": {
        "type": "code",
        "lines": [
